{
  "name": "openclaw-plugin-bifrost",
  "version": "0.2.0",
  "description": "OpenClaw provider plugin for the Bifrost AI gateway, with live model discovery.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config ./vitest.config.ts",
    "validate": "npm run build && clawhub package validate . --out .clawhub-validation",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:native": "npm run build && node scripts/native-smoke.mjs"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "docs"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "clawhub": "latest",
    "openclaw": "2026.10.9",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9"
    },
    "install": {
      "clawhubSpec": "clawhub:openclaw-plugin-bifrost",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.10.9"
    },
    "release": {
      "publishToClawHub": true
    }
  },
  "pluginInspector": {
    "version": 1,
    "plugin": {
      "id": "bifrost",
      "priority": "high",
      "seams": [
        "plugin-runtime"
      ],
      "sourceRoot": ".",
      "expect": {
        "registrations": [
          "registerProvider"
        ]
      }
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "bifrost",
    "ai-gateway",
    "provider"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  }
}
